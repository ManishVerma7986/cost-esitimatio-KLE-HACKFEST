# ==============================================================================
# Costimator Environment Configuration Template
# Duplicate this file as '.env' and populate with your local values.
# DO NOT commit '.env' with real secrets to version control.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to local SQLite; override with PostgreSQL when ready (e.g. postgresql://user:pass@localhost:5432/costimator)
DATABASE_URL=sqlite:///./data/costimator.db

# ── LLM Providers (NVIDIA Nemotron / Google Gemini) ───────────────────────────
# Obtain NVIDIA API key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Obtain Google Gemini key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Primary provider strategy: "nemotron" | "gemini"
LLM_PROVIDER=nemotron

# Model identifiers
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# LLM resilience settings
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate a strong 32+ character random secret key for production JWT tokens
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# JWT Access token lifespan in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default Development User Credentials (for local dev bypass / demo)
DEV_USER_EMAIL=dev@costimator.local
DEV_USER_PASSWORD=development_pass_123

# ── Application Environment ───────────────────────────────────────────────────
# Application mode: "development" | "production" | "testing"
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# File uploads limit (in MB)
MAX_UPLOAD_SIZE_MB=50

# Monte Carlo simulation iterations for cost uncertainty analysis
MONTE_CARLO_SIMULATIONS=10000
